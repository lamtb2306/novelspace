POSTGRES_USER=novelspace_user
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=novelspace_db
DATABASE_URL=postgresql://novelspace_user:change_me_postgres_password@postgres:5432/novelspace_db

ADMIN_TOKEN=change_me_admin_token
SECRET_KEY=change_me_secret_key
SITE_URL=https://novel-space.com
LOG_LEVEL=INFO

CACHE_ENABLED=true
REDIS_URL=redis://redis:6379/0
CACHE_KEY_PREFIX=novelspace
CACHE_DEFAULT_TTL=300
CACHE_TRENDING_TTL=300
CACHE_RELATED_TTL=300
CACHE_SEARCH_TTL=120
CACHE_HOMEPAGE_TTL=300
CACHE_RECENT_TTL=300

RATE_LIMIT_STORAGE_URL=redis://redis:6379/1
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute
COMMENT_RATE_LIMIT=10/minute
BOOKMARK_RATE_LIMIT=20/minute

ACCESS_TOKEN_EXPIRE_MINUTES=43200
JWT_ISSUER=
JWT_AUDIENCE=
SECURITY_HEADERS_ENABLED=true
SECURE_HSTS_ENABLED=true
CSP_REPORT_ONLY=false
ANTI_BOT_ENABLED=true
SUSPICIOUS_IP_LOGGING_ENABLED=true
BLOCKED_USER_AGENT_PATTERNS=sqlmap,nikto,nmap,masscan,acunetix,nessus,dirbuster,gobuster,python-requests,curl
